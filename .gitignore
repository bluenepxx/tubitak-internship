# ==================================================
# Python
# ==================================================

# Virtual environment
.venv/
venv/
env/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ==================================================
# Jupyter Notebook
# ==================================================

.ipynb_checkpoints/


# ==================================================
# IDE settings
# ==================================================

.vscode/
.idea/


# ==================================================
# Environment and local configuration
# ==================================================

.env
.env.*
*.local


# ==================================================
# Dataset
# ==================================================

# Original QMOF dataset must not be uploaded
data/raw/

# Locally generated processed data
data/processed/*
!data/processed/.gitkeep


# ==================================================
# Model files
# ==================================================

# Trained models are not committed (2 of the 3 winners are ~170MB each, over
# GitHub's non-LFS limit). Regenerate them with:
#   python -m src.run_30_models --mode full --stages final_test
results/models/*
!results/models/.gitkeep
/models/

*.joblib
*.pkl
*.pickle
*.pt
*.pth
*.ckpt
*.h5
*.onnx


# ==================================================
# Experiment outputs
# ==================================================

# results/tables, results/plots and results/figures are the canonical outputs
# the report is based on -- these are committed, unlike the rest of results/.

# Old/broken experiment runs kept around locally for reference, never used in
# the report (see HANDOFF_UPDATE.md section 0)
results/corrupt_backup/
results/smoke_backup/
results/run_manifest_kfold_run_backup.json

# Staging copies of Colab-trained results already merged into results/tables/
results/transformer_import/

# Regenerated on every run, not needed for review
results/logs/
results/histories/


# ==================================================
# Logs and temporary files
# ==================================================

*.log
logs/
temp/
tmp/


# ==================================================
# Operating system files
# ==================================================

.DS_Store
Thumbs.db
desktop.ini